{
  "name": "mindustry-mod-creator",
  "version": "1.0.0",
  "description": "Mindustry-Scratch 在线图形化 Mod 编辑器",
  "private": true,
  "workspaces": [
    "packages/backend"
  ],
  "scripts": {
    "dev": "bun run --filter backend dev",
    "build": "bun run --filter backend build",
    "lint": "bun run --filter backend lint",
    "test": "bun run --filter backend test",
    "clean": "bun run --filter backend clean",
    "turbowarp:install": "cd packages/turbowarp && npm install",
    "turbowarp:build": "cd packages/turbowarp && npm run build",
    "turbowarp:dev": "cd packages/turbowarp && npm start",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^10.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.5",
    "typescript": "~5.8.0",
    "typescript-eslint": "^8.63.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=24.0.0",
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "hjson": "^3.2.2"
  }
}
