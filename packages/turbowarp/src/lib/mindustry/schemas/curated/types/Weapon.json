        { "name": "shootStatusDuration", "type": "number", "localizedName": "射击状态持续时间", "defaultValue": "300.0", "notes": "射击时状态效果的持续时间。" },
        { "name": "shootOnDeath", "type": "boolean", "localizedName": "死亡时自动开火", "defaultValue": "false", "notes": "此武器是否应在所有者死亡时开火。" },
