        { "name": "ignoreRotation", "type": "boolean", "localizedName": "忽略射手旋转", "defaultValue": "false", "notes": "射击时是否忽略射手的旋转。" },
        { "name": "noAttack", "type": "boolean", "localizedName": "不能攻击", "defaultValue": "false", "notes": "若为true，此武器不能用于攻击目标。" },
