{
    "type": "object",
    "localizedName": "武器",
    "fields": [
        { "name": "name", "type": "string", "localizedName": "武器名称", "defaultValue": "Weapon Name", "notes": "显示的武器纹理区域。" },
        { "name": "bullet", "type": "string", "localizedName": "子弹类型", "defaultValue": "placeholder", "notes": "发射的子弹。" },
        { "name": "ejectEffect", "type": "string", "localizedName": "弹壳抛射特效", "defaultValue": "none", "notes": "弹壳抛射特效。" },
        { "name": "display", "type": "boolean", "localizedName": "显示在统计中", "defaultValue": "true", "notes": "武器是否应出现在具有此武器的单位属性中。" },
        { "name": "mirror", "type": "boolean", "localizedName": "生成镜像武器", "defaultValue": "true", "notes": "初始化时是否创建此武器的翻转副本。" },
        { "name": "flipSprite", "type": "boolean", "localizedName": "翻转精灵（仅供内部）", "defaultValue": "false", "notes": "渲染时是否翻转武器的精灵。仅供内部使用——请勿设置！" },
        { "name": "alternate", "type": "boolean", "localizedName": "交替射击", "defaultValue": "true", "notes": "是否在不同臂之间交替射击，而非同时开火；仅当mirror = true时有效。" },
        { "name": "rotate", "type": "boolean", "localizedName": "独立旋转", "defaultValue": "false", "notes": "是否独立于单位朝向目标旋转。" },
        { "name": "showStatSprite", "type": "boolean", "localizedName": "数据库显示精灵", "defaultValue": "true", "notes": "是否在核心数据库中显示武器的精灵。" },
        { "name": "baseRotation", "type": "number", "localizedName": "基础旋转角度", "defaultValue": "0.0", "notes": "武器的起始旋转角度。" },
        { "name": "top", "type": "boolean", "localizedName": "顶层绘制轮廓", "defaultValue": "true", "notes": "是否在顶层绘制轮廓。" },
        { "name": "continuous", "type": "boolean", "localizedName": "持续型武器", "defaultValue": "false", "notes": "开火时是否将子弹固定在原位；仍需要装填。" },
        { "name": "alwaysContinuous", "type": "boolean", "localizedName": "无需装填持续开火", "defaultValue": "false", "notes": "此武器是否使用不装填的持续开火；隐含continuous = true。" },
        { "name": "aimChangeSpeed", "type": "number", "localizedName": "瞄准变化速度", "defaultValue": "Infinity", "notes": "炮塔改变子弹'瞄准'距离的速度。仅用于点激光子弹。" },
        { "name": "controllable", "type": "boolean", "localizedName": "玩家可控", "defaultValue": "true", "notes": "此武器是否可由玩家手动瞄准。" },
        { "name": "aiControllable", "type": "boolean", "localizedName": "AI可控", "defaultValue": "true", "notes": "此武器是否可由单位自动瞄准。" },
        { "name": "alwaysShooting", "type": "boolean", "localizedName": "始终射击", "defaultValue": "false", "notes": "此武器是否始终射击，无视目标或角度锥。" },
        { "name": "autoTarget", "type": "boolean", "localizedName": "自动寻找目标", "defaultValue": "false", "notes": "是否在update()中自动瞄准相关单位；仅当controllable = false时有效。" },
        { "name": "predictTarget", "type": "boolean", "localizedName": "预测目标", "defaultValue": "true", "notes": "是否执行目标轨迹预测。" },
        { "name": "useAttackRange", "type": "boolean", "localizedName": "计入攻击范围", "defaultValue": "true", "notes": "若为true，此武器用于攻击范围计算。" },
        { "name": "targetInterval", "type": "number", "localizedName": "目标搜索间隔", "defaultValue": "40.0", "notes": "目标搜索之间的等待tick数。" },
        { "name": "targetSwitchInterval", "type": "number", "localizedName": "目标切换间隔", "defaultValue": "70.0", "notes": "目标切换之间的等待tick数。" },
        { "name": "rotateSpeed", "type": "number", "localizedName": "旋转速度", "defaultValue": "20.0", "notes": "开启旋转时武器的旋转速度（度/t）。" },
        { "name": "reload", "type": "number", "localizedName": "装填时间", "defaultValue": "1.0", "notes": "武器装填时间（帧）。" },
        { "name": "inaccuracy", "type": "number", "localizedName": "散布精度", "defaultValue": "0.0", "notes": "每次射击的不精确度（度）。" },
        { "name": "shake", "type": "number", "localizedName": "震屏强度", "defaultValue": "0.0", "notes": "每次射击的屏幕震动强度和持续时间。" },
        { "name": "recoil", "type": "number", "localizedName": "后坐力", "defaultValue": "1.5", "notes": "视觉武器后坐力。" },
        { "name": "recoils", "type": "number", "localizedName": "后坐力计数器数", "defaultValue": "-1", "notes": "后坐力的额外计数器数量。" },
        { "name": "recoilTime", "type": "number", "localizedName": "后坐恢复时间", "defaultValue": "-1.0", "notes": "武器恢复到起始位置的tick数，默认使用装填时间。" },
        { "name": "recoilPow", "type": "number", "localizedName": "后坐力曲线指数", "defaultValue": "1.8", "notes": "应用到视觉后坐力的幂曲线。" },
        { "name": "cooldownTime", "type": "number", "localizedName": "冷却时间", "defaultValue": "20.0", "notes": "热力区域冷却的tick数。" },
        { "name": "shootX", "type": "number", "localizedName": "射击点X偏移", "defaultValue": "0.0", "notes": "抛射物/特效从武器中心的偏移。" },
        { "name": "shootY", "type": "number", "localizedName": "射击点Y偏移", "defaultValue": "3.0", "notes": "抛射物/特效从武器中心的偏移。" },
        { "name": "x", "type": "number", "localizedName": "武器X位置偏移", "defaultValue": "5.0", "notes": "武器在单位上的位置偏移。" },
        { "name": "y", "type": "number", "localizedName": "武器Y位置偏移", "defaultValue": "0.0", "notes": "武器在单位上的位置偏移。" },
        { "name": "xRand", "type": "number", "localizedName": "X轴随机散布", "defaultValue": "0.0", "notes": "X/Y轴上的随机散布。" },
        { "name": "yRand", "type": "number", "localizedName": "Y轴随机散布", "defaultValue": "0.0", "notes": "X/Y轴上的随机散布。" },
        { "name": "shoot", "type": "string", "localizedName": "发射模式", "defaultValue": "new ShootPattern()", "notes": "子弹发射模式。" },
        { "name": "shadow", "type": "number", "localizedName": "阴影半径", "defaultValue": "-1.0", "notes": "武器下方阴影的半径；<0禁用。" },
        { "name": "velocityRnd", "type": "number", "localizedName": "速度随机比例", "defaultValue": "0.0", "notes": "速度随机化的比例。" },
        { "name": "extraVelocity", "type": "number", "localizedName": "额外速度加成", "defaultValue": "0.0", "notes": "作为比例添加的额外速度。" },
        { "name": "shootCone", "type": "number", "localizedName": "射击允许角度", "defaultValue": "5.0", "notes": "开始射击的锥体半半径（度）。" },
        { "name": "rotationLimit", "type": "number", "localizedName": "旋转角度限制", "defaultValue": "361.0", "notes": "武器可绕其基座旋转的锥体范围。" },
        { "name": "minWarmup", "type": "number", "localizedName": "最小预热需求", "defaultValue": "0.0", "notes": "开火前的最低武器预热值（不是线性的，请勿使用1！）。" },
        { "name": "shootWarmupSpeed", "type": "number", "localizedName": "预热速度", "defaultValue": "0.1", "notes": "射击预热的插值速度，仅用于部件。" },
        { "name": "smoothReloadSpeed", "type": "number", "localizedName": "平滑装填速度", "defaultValue": "0.15", "notes": "射击预热的插值速度，仅用于部件。" },
        { "name": "linearWarmup", "type": "boolean", "localizedName": "线性预热", "defaultValue": "false", "notes": "若为true，预热为线性而非曲线。" },
