  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.26.4",
    "@babel/core": "^7.26.9",
    "@babel/eslint-parser": "^7.29.7",
    "@babel/plugin-proposal-object-rest-spread": "^7.14.7",
    "@babel/plugin-syntax-dynamic-import": "^7.2.0",
    "@babel/plugin-transform-async-to-generator": "^7.14.5",
    "@babel/preset-env": "^7.26.0",
    "@babel/preset-react": "^7.26.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^13.5.0",
    "babel-core": "7.0.0-bridge.0",
    "babel-loader": "^9.0.0",
    "base64-loader": "^1.0.0",
    "chromedriver": "150.0.3",
    "copy-webpack-plugin": "^12.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "file-loader": "^6.2.0",
    "gh-pages": "6.3.0",
    "html-webpack-plugin": "^5.6.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "jest-junit": "17.0.0",
    "mkdirp": "3.0.1",
    "raf": "3.4.1",
    "raw-loader": "^4.0.2",
    "redux-mock-store": "1.5.3",
    "rimraf": "6.1.3",
    "selenium-webdriver": "4.46.0",
    "url-loader": "^4.1.1",
    "web-audio-test-api": "0.5.2",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.0.0",
    "webpack-dev-server": "^5.0.0",
    "worker-loader": "^2.0.0",
    "yauzl": "3.4.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFiles": [
      "raf/polyfill"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/test/helpers/setup.js"
    ],
    "testPathIgnorePatterns": [
      "src/test.js"
    ],
    "moduleNameMapper": {
      "\\.(jpg|jpeg|png|gif|eot|otf|webp|svg|ttf|woff|woff2|mp4|webm|wav|mp3|m4a|aac|oga)$": "<rootDir>/test/__mocks__/fileMock.js",
      "\\.(css|less)$": "<rootDir>/test/__mocks__/styleMock.js",
      "editor-msgs(\\.js)?$": "<rootDir>/test/__mocks__/editor-msgs-mock.js",
      "immutable": "<rootDir>/test/__mocks__/immutable.js",
      "scratch-render-fonts": "<rootDir>/test/__mocks__/scratch-render-fonts.js",
      "^uuid$": "<rootDir>/test/__mocks__/uuid.js",
      "^scratch-audio$": "<rootDir>/test/__mocks__/scratch-audio.js"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!uuid|scratch-vm|@turbowarp/scratch-svg-renderer|turbowarp-|tapable|scratch-parser|scratch-render-fonts|scratch-storage|scratch-svg-renderer)"
    ]
  }
}
