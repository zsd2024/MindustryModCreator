    "scratch-vm": "github:TurboWarp/scratch-vm#develop",
    "split-on-first": "^4.0.0",
    "strict-uri-encode": "^2.0.0",
    "style-loader": "^4.0.0",
    "text-encoding": "0.7.0",
    "to-style": "1.3.3",
    "tslib": "^2.8.1",
    "url": "^0.11.4",
    "url-polyfill": "^1.1.14",
