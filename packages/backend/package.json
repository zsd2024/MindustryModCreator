    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/typeorm": "^11.0.3",
    "bullmq": "^5.80.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dockerode": "^5.0.1",
    "hjson": "^3.2.2",
    "ioredis": "^5.11.1",
    "minio": "^8.0.7",
    "pg": "^8.22.0",
